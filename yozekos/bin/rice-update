#!/usr/bin/env python3
"""Local NixOS update status for YozekOS. System changes require explicit root authentication."""
import json
import subprocess
import sys
import time

args = sys.argv[1:]
if args[:2] == ['watch', 'state']:
    print(json.dumps({'watch': False, 'every_minutes': 0}))
elif args and args[0] == 'check':
    version = subprocess.run(['nixos-version'], capture_output=True, text=True).stdout.strip()
    state = {'installed': version, 'latest': version, 'update': False, 'changes': 0,
             'news': [], 'checked': int(time.time()),
             'error': 'YozekOS system updates are managed by nixos-rebuild; no online check was performed.'}
    print(json.dumps(state) if '--json' in args else state['error'])
elif args in (['--help'], ['help']):
    print(__doc__)
else:
    print('Use YozekOS Settings > System Updates or sudo nixos-rebuild switch --no-flake.', file=sys.stderr)
    sys.exit(2)
