#!/usr/bin/env python3
"""Favorites and recent applications for the YozekOS Start menu."""
import json
import os
from pathlib import Path
import sys

home = Path.home()
files = {
    'favorites': home / '.config/yozekos/favorites.json',
    'recent': home / '.local/state/yozekos/recent.json',
}

def read(kind):
    try:
        value = json.loads(files[kind].read_text())
        return [x for x in value if isinstance(x, str)] if isinstance(value, list) else []
    except (OSError, ValueError):
        return []

def write(kind, value):
    path = files[kind]
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix('.json.tmp')
    temp.write_text(json.dumps(value, ensure_ascii=False))
    os.replace(temp, path)

cmd = sys.argv[1] if len(sys.argv) > 1 else ''
if cmd in files:
    print(json.dumps(read(cmd), ensure_ascii=False))
elif cmd in ('record', 'toggle') and len(sys.argv) == 3 and 0 < len(sys.argv[2]) < 256:
    ident = sys.argv[2]
    kind = 'recent' if cmd == 'record' else 'favorites'
    old = read(kind)
    value = ([ident] + [x for x in old if x != ident])[:12] if cmd == 'record' else ([x for x in old if x != ident] if ident in old else old + [ident])
    write(kind, value)
else:
    print('Usage: yozekos-launcher-state favorites|recent|record ID|toggle ID', file=sys.stderr)
    sys.exit(2)
